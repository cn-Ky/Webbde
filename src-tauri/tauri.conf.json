{
  "productName": "Webbde",
  "version": "0.3.0",
  "identifier": "app.webbde.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Webbde", "width": 1200, "height": 800, "minWidth": 920, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "UPDATER_PUBKEY",
      "endpoints": ["https://github.com/GITHUB_REPO/releases/latest/download/latest.json"]
    }
  }
}
